# The tools the workflows run from container images, pinned here and nowhere
# else. The tag says which version it is; the digest is what docker pulls.
# Workflows load this file into the job environment.
#
# To move a pin, replace the tag and the digest together. The digest of a tag
# is the first "Digest:" line printed by
#   docker buildx imagetools inspect IMAGE:TAG
HADOLINT_IMAGE=ghcr.io/hadolint/hadolint:v2.15.1@sha256:32dac94127fd60b7b7e3fbfc65e1383b9b5e25c9bfd7b8536de7a539fe68a12d
ACTIONLINT_IMAGE=docker.io/rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667
GITLEAKS_IMAGE=ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f
TRIVY_IMAGE=ghcr.io/aquasecurity/trivy:0.75.0@sha256:af6acf9a6b85dfe389a1941505c0ce9efef52a4719635e1a962f022a3d855daa
COSIGN_IMAGE=ghcr.io/sigstore/cosign/cosign:v3.1.3@sha256:9e5c2f2edc34351160407ca3416c61855bdf9403c3c5936e0f0be7fc261611b8

# cosign and Kyverno move as a pair, because Kyverno has to read what cosign
# writes. cosign 3 stores a signature or an attestation as a Sigstore bundle
# attached to the image as an OCI referrer, where cosign 2 used a ".sig" or
# an ".att" tag. Kyverno 1.19.1 is built with the cosign 3.1.2 library, and
# its ImageValidatingPolicy looks for these bundles before the old tags.
# Kyverno is installed from its Helm chart: chart 3.9.1 is Kyverno 1.19.1.
KYVERNO_CHART_VERSION=3.9.1
